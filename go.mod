module bodsch.me/mailcow-dockerapi

// Patch version matters: govulncheck flags five standard-library issues below
// 1.26.6 (net/url, crypto/tls, net/http x2, encoding/asn1), and CI installs
// exactly this toolchain via setup-go's go-version-file. mailcow-watchdog pins
// the same version — see CONVENTIONS.md.
go 1.26.6

require (
	github.com/alicebob/miniredis/v2 v2.38.0
	github.com/moby/moby/client v0.5.1
	github.com/prometheus/client_golang v1.24.1
	github.com/redis/go-redis/v9 v9.22.0
	github.com/shirou/gopsutil/v4 v4.26.7
)

